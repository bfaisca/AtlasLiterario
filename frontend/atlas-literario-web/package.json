{
  "name": "atlas-literario-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write src/ scripts/",
    "format:check": "prettier --check src/ scripts/",
    "geo:fetch": "node scripts/fetch-geo.mjs"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "maplibre-gl": "^6.18.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.45",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.7",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^27.4.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  }
}
